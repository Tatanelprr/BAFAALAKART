rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    function isFormateur() {
      return isAuth() && (getRole() == 'formateur' || getRole() == 'admin');
    }

    function isStagiaire() {
      return isAuth() && getRole() == 'stagiaire';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── users ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isFormateur();
      allow write: if isAdmin();
    }

    // ─── session ───────────────────────────────────────────────────
    match /session/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── creneaux ──────────────────────────────────────────────────
    match /creneaux/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── temps ─────────────────────────────────────────────────────
    match /temps/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── ateliers ──────────────────────────────────────────────────
    match /ateliers/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── inscriptions ──────────────────────────────────────────────
    match /inscriptions/{docId} {
      // Lecture : tout utilisateur authentifié
      // (isAuth() évite getRole() dans les transactions Firestore)
      allow read: if isAuth();

      // Création : stagiaire pour soi-même (verrouillé ou non) ou admin
      // Note: verrouille==true est nécessaire pour inscrireAtelier
      allow create: if isAdmin() ||
        (isAuth() && request.resource.data.stagiaireId == request.auth.uid);

      // Mise à jour : admin ou formateur
      allow update: if isAdmin() || isFormateur();

      // Suppression : admin ou propriétaire non verrouillée
      allow delete: if isAdmin() ||
        (isAuth() &&
         resource.data.stagiaireId == request.auth.uid &&
         resource.data.verrouille == false);
    }

    // ─── slots (contrainte unicité créneau) ────────────────────────
    match /slots/{docId} {
      allow read, write: if isAuth();
    }

    // ─── presences ─────────────────────────────────────────────────
    match /presences/{docId} {
      allow read: if isFormateur() || (isStagiaire() && resource.data.stagiaireId == request.auth.uid);
      allow write: if isFormateur();
    }

    // ─── historique ────────────────────────────────────────────────
    match /historique/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }
  }
}
